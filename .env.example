# Inference API
DDPM_WEIGHTS=./ddpm_fashion_mnist.pth
DDPM_DEVICE=auto

# Training inputs and outputs
DDPM_DATA_DIR=./data
DDPM_CHECKPOINT=./artifacts/ddpm_fashion_mnist.pth
DDPM_MIXED_PRECISION=no

# Weights & Biases (set your real key in .env; never commit it)
WANDB_API_KEY=
WANDB_PROJECT=fashion-mnist-ddpm
WANDB_ENTITY=
